# Copy to .env.local. All variables are prefixed NEXT_PUBLIC_, so Next.js
# inlines them at build time: change a value, then rebuild or restart `next dev`.
# Empty and unset behave the same unless a line says otherwise.

# Network the app opens on before a wallet is connected: testnet | mainnet.
# Any other value, or leaving it empty, means testnet.
NEXT_PUBLIC_DEFAULT_NETWORK=testnet

# RPC endpoint override. Empty uses the public default for each network:
#   testnet default: https://soroban-testnet.stellar.org
#   mainnet default: https://mainnet.sorobanrpc.com
NEXT_PUBLIC_TESTNET_RPC_URL=
NEXT_PUBLIC_MAINNET_RPC_URL=

# Contract ids. Empty uses the built-in testnet deployment (recorded in
# stellar-subscriptions-contracts/DEPLOYMENTS.md). Set these to point elsewhere.
NEXT_PUBLIC_TESTNET_SUBSCRIPTION_CONTRACT=CAW5H4BH5VXWR23DFUVMY45TL7JSMTDZTH3E7LMMXW5LZ7FMDL33KXMM
NEXT_PUBLIC_TESTNET_PLAN_CONTRACT=CDKFRKPA2EIYMW2GX2FY4ZFQ2VAFS5UZD5BHAZLCIGRA7N24N2DFAYN3
NEXT_PUBLIC_TESTNET_REGISTRY_CONTRACT=CB7HBXFNBLUSBY3SMIYUPVTE3JZTISYRMZB7XXPUC3ZPLIDNPTKUX645

# Mainnet is not deployed yet. Mainnet is treated as deployed only when all
# three contract ids are set. If any one is empty, Mainnet shows "not deployed
# on Mainnet" and the network selector marks it "(not deployed)". Nothing fails.
NEXT_PUBLIC_MAINNET_SUBSCRIPTION_CONTRACT=
NEXT_PUBLIC_MAINNET_PLAN_CONTRACT=
NEXT_PUBLIC_MAINNET_REGISTRY_CONTRACT=

# Funded account used only as the source of read-only simulations, which never
# spend anything. Empty on testnet uses a built-in funded account. Empty on
# Mainnet means reads are unavailable: set this once the Mainnet contracts are set.
NEXT_PUBLIC_TESTNET_READ_ACCOUNT=GBQHBOJHJ3SPU5TYNOABLKIXOZQFMN25ZNALA3QC46Q3I4IN5Q2KXZXI
NEXT_PUBLIC_MAINNET_READ_ACCOUNT=

# GitHub organization linked from the footer. Empty uses stellar-sub.
NEXT_PUBLIC_GITHUB_ORG=
